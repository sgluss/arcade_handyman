# ---------------------------------------------------------------------------
# Request plumbing — the single HTTP door every tool goes through
# ---------------------------------------------------------------------------


def _request(
    method: str,
    path: str,
    params: dict[str, Any] | None = None,
    headers: dict[str, str] | None = None,
) -> Any:
    """Issue one API request and return parsed JSON, raising a readable error
    on HTTP failure so the calling agent can react."""
    all_headers = dict(_DEFAULT_HEADERS)
    all_headers.update(headers or {})
    response = httpx.request(
        method,
        BASE_URL + path,
        params=params or None,
        headers=all_headers,
        timeout=30,
        follow_redirects=True,
    )
    if response.status_code >= 400:
        raise RuntimeError(f"{method} {path} failed ({response.status_code}): {response.text[:300]}")
    return response.json()


def _dig(payload: Any, path: str) -> Any:
    """Follow a dot path into a JSON payload, failing loudly when it is absent.
    Used between chained calls, where a missing value means the chain is wrong."""
    value = payload
    for key in path.split("."):
        if not isinstance(value, dict) or key not in value:
            available = sorted(value.keys()) if isinstance(value, dict) else type(value).__name__
            raise RuntimeError(f"response missing '{path}' (at '{key}'; found: {available})")
        value = value[key]
    return value


def _prune(payload: Any, path: str) -> Any:
    """Best-effort final shaping: return the payload at a dot path, or the full
    payload when the shape drifted — a bigger answer beats a broken tool."""
    value = payload
    for key in path.split("."):
        if not isinstance(value, dict) or key not in value:
            return payload
        value = value[key]
    return value


def _as_object(value: Any) -> dict:
    """Tools always return a JSON object; non-object payloads are wrapped."""
    return value if isinstance(value, dict) else {"result": value}


