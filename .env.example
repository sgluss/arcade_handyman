# --- Required ---
# Used by the Design/Verify stages and the demo agent. This is the ONLY key the
# core demo needs.
ANTHROPIC_API_KEY=sk-ant-...

# --- Recommended ---
# api.weather.gov asks clients to identify themselves via User-Agent and may
# throttle anonymous traffic. Any app name + contact works.
NWS_USER_AGENT="toolsmith-demo (you@example.com)"

# Where "home" is for the weather demo task (default: Seattle).
HOME_LAT=47.6062
HOME_LON=-122.3321

# --- Optional ---
# Only needed for the `arcade deploy` flourish (publishing a generated server
# to Arcade Cloud). Not used by the local demo path.
# ARCADE_API_KEY=arc_...
